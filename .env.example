# ==============================================================================
# DARNA E-COMMERCE ENVIRONMENT VARIABLES (.env.example)
# Add these in Netlify: Site Settings > Environment Variables
# And in Supabase: Project Settings > API
# ==============================================================================

# Public Supabase URL (safe for browser and server)
SUPABASE_URL="https://your-project-id.supabase.co"

# Public Supabase Anon Key (safe for browser and public queries)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SECRET: Supabase Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE IN CLIENT CODE!)
# Used inside Netlify serverless functions for order placement & privileged admin operations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Business WhatsApp Contact (Tunisia format with +216)
WHATSAPP_NUMBER="+21627900771"

# Google Analytics 4 Measurement ID (Optional, format: G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=""
